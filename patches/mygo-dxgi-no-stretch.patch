+// SetBackground sets the color a window shows where a frame does not cover
+// it, which a swap chain that does not stretch a stale frame leaves while the
+// window changes size.
+func (r *Renderer) SetBackground(r8, g8, b8, a8 uint8) {
+	r.bg = [4]float32{float32(r8) / 255, float32(g8) / 255, float32(b8) / 255, float32(a8) / 255}
+	r.hasBG = true
+	r.setBackground()
+}
+
+// setBackground applies the background color to the swap chain.
+func (r *Renderer) setBackground() {
+	if r.swapChain == 0 || !r.hasBG {
+		return
+	}
+	c := r.bg
+	call(r.swapChain, scSetBackgroundColor, uintptr(unsafe.Pointer(&c)))
+}
