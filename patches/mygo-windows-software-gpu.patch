# Applies after mygo-dxgi-no-stretch.patch, whose changes in ui/gpu_windows.go and
# internal/gpu/d3d11/d3d11.go it builds on: scripts/build-gui.sh applies
# patches/mygo-*.patch in name order.
diff --git a/internal/gpu/d3d11/d3d11.go b/internal/gpu/d3d11/d3d11.go
index 32882f0..8cbe2f1 100644
--- a/internal/gpu/d3d11/d3d11.go
+++ b/internal/gpu/d3d11/d3d11.go
@@ -18,6 +18,7 @@ import (
 	"log"
 	"math"
 	"os"
+	"strings"
 	"syscall"
 	"time"
 	"unsafe"
@@ -99,6 +100,7 @@ const (
 	ctxClearState              = 110
 	ctxFlush                   = 111
 	ctx1ClearView              = 132 // ID3D11DeviceContext1
+	adapterGetDesc             = 8   // IDXGIAdapter, after IDXGIObject's GetParent
 	dxgiDevGetAdapter          = 7
 	dxgiDevSetMaxLatency       = 12 // IDXGIDevice1::SetMaximumFrameLatency
 	dxgiGetParent              = 6
@@ -243,6 +245,17 @@ type presentParameters struct {
 	ScrollOffset    uintptr
 }
 
+// adapterDesc is DXGI_ADAPTER_DESC.
+type adapterDesc struct {
+	Description           [128]uint16
+	VendorID, DeviceID    uint32
+	SubSysID, Revision    uint32
+	DedicatedVideoMemory  uintptr
+	DedicatedSystemMemory uintptr
+	SharedSystemMemory    uintptr
+	AdapterLuid           int64
+}
+
 type swapChainDesc1 struct {
 	Width, Height, Format          uint32
 	Stereo                         int32
@@ -279,6 +292,7 @@ type Renderer struct {
 	rtv       uintptr
 	w, h      int  // the size drawn, which the swap chain shows
 	warp      bool // the device is WARP, Windows' software rasterizer
+	slow      bool // the adapter shows a resized window late, as a virtual one does
 
 	// composed tells that the swap chain shows on the window through
 	// DirectComposition, with its alpha, as the content of visual, the
@@ -433,6 +447,16 @@ func (r *Renderer) init() error {
 		return errors.New("d3d11: no adapter")
 	}
 	defer free(&adapter)
+	name, virtual := virtualAdapter(adapter)
+	switch {
+	case virtual:
+		r.slow = true
+		log.Printf("mygo: the display adapter %q cannot follow a resized window: drawing in memory", name)
+	case name != "":
+		log.Printf("mygo: the display adapter is %q", name)
+	default:
+		log.Print("mygo: the display adapter has no description")
+	}
 	if failed(call(adapter, dxgiGetParent, uintptr(unsafe.Pointer(&iidIDXGIFactory2)), uintptr(unsafe.Pointer(&r.factory)))) {
 		return errors.New("d3d11: DXGI 1.2 is required")
 	}
@@ -680,6 +704,35 @@ func (r *Renderer) Composed() bool { return r.composed }
 // want of a GPU.
 func (r *Renderer) Software() bool { return r.warp }
 
+// virtualAdapter reports whether a display adapter shows a resized window
+// late, as a virtual machine's or a display-only one does, and its name. Such
+// an adapter shows the frame of a window that changed size after the window
+// has it, which Windows fills with the old frame stretched into the new size:
+// a window that follows its content on every frame of a resize would show that
+// while it moves.
+func virtualAdapter(a uintptr) (string, bool) {
+	var d adapterDesc
+	if failed(call(a, adapterGetDesc, uintptr(unsafe.Pointer(&d)))) {
+		return "", false
+	}
+	name := syscall.UTF16ToString(d.Description[:])
+	lower := strings.ToLower(name)
+	for _, mark := range []string{
+		"basic render", "basic display", "dod controller",
+		"virtio", "qemu", "vmware", "virtualbox", "hyper-v", "parallels",
+		"remote display", "citrix",
+	} {
+		if strings.Contains(lower, mark) {
+			return name, true
+		}
+	}
+	return name, false
+}
+
+// Slow reports whether the renderer's display adapter shows a window's
+// resized frame after the window has it, as a virtual machine's does.
+func (r *Renderer) Slow() bool { return r.slow }
+
 // settling holds the windows whose settle timer is armed; settleProc is
 // the timers' callback, made once.
 var (
diff --git a/ui/gpu_windows.go b/ui/gpu_windows.go
index bcb23f4..5e8cddd 100644
--- a/ui/gpu_windows.go
+++ b/ui/gpu_windows.go
@@ -25,5 +25,23 @@ func newGPURenderer(n platform.SurfaceNative) (gpuRenderer, error) {
 	if n.HasBackground {
 		r.SetBackground(n.Background.R, n.Background.G, n.Background.B, n.Background.A)
 	}
+	if r.Software() {
+		// Without a 3D adapter, as a virtual machine has, Windows draws with
+		// WARP, its software rasterizer: it presents a frame of a new window
+		// size after the window has it, which Windows shows as the last frame
+		// stretched into the new size. A window that follows its content on
+		// every frame of a resize would show that while it moves, so the
+		// window draws in memory instead, as this package does without a GPU.
+		r.Release()
+		return nil, errors.New("Direct3D draws in software: no 3D adapter")
+	}
+	if r.Slow() {
+		// A virtual machine's display adapter is the same: the frame of the
+		// size before a resize shows stretched into the new size until the
+		// frame of the new one comes, slowly enough that it shows on every
+		// frame of an animated resize.
+		r.Release()
+		return nil, errors.New("the display adapter cannot follow a resized window")
+	}
 	return r, nil
 }
