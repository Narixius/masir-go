# PostHog project token for anonymous analytics. This is a public write-only key.
MASIR_POSTHOG_KEY?=
MASIR_POSTHOG_HOST?=https://eu.i.posthog.com

# The Ed25519 key that signs desktop app updates. Generate it with:
#   cd apps/masir-gui && go tool mygo keygen
# Put the public key from mygo-update.pub into apps/masir-gui/mygo.json's
# updates.publicKey, and keep the private key (mygo-update.key) here for local
# signed builds, or in the MYGO_UPDATER_PRIVATE_KEY GitHub secret for releases.
# Back it up: installed apps accept only updates signed with it, and losing it
# means they cannot update.
MYGO_UPDATER_PRIVATE_KEY=
